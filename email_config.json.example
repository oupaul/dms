{
  "enabled": false,
  "smtp": {
    "host": "smtp.example.com",
    "port": 587,
    "secure": false,
    "auth": {
      "user": "your-smtp-username",
      "pass": "your-smtp-password"
    }
  },
  "from": "notify@example.com",
  "to": ["admin@example.com"],
  "subjectPrefix": "[資料夾權限系統]",
  "batchMinutes": 10,
  "notifyEvents": {
    "folder": true,
    "user": true,
    "group": true,
    "permission": true,
    "invite": true
  }
}
